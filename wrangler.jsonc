{
  // Configuración de Cloudflare Workers para NEXUS Home
  "name": "nexus-home",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  // Archivos estáticos del dashboard (HTML, CSS, JS) que verá la tablet
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Almacenamiento persistente (alarmas y ajustes). Plan gratuito.
  "kv_namespaces": [
    { "binding": "NEXUS_KV", "id": "e5b8d82e7f8d4252bc1a88c96abdfdff" }
  ],

  // Workers AI: voz a texto (Whisper), asistente (gpt-oss-120b) y voz (Aura-2).
  // Plan gratuito con cuota diaria de 10.000 neuronas.
  "ai": { "binding": "AI" },

  // Voz del asistente (Aura-2 español): sirio, nestor, carina, celeste, alvaro,
  // diana, aquila, selena, estrella, javier
  "vars": { "TTS_VOICE": "carina" },

  // Secretos (no se guardan aquí): NEXUS_TOKEN, FAMILY_TOKEN, NEXUS_HOME, GOOGLE_SA, GOOGLE_CALENDARS,
  // SHELLY_AUTH_KEY, SHELLY_SERVER
  // Se configuran con: npx wrangler secret put NEXUS_TOKEN

  "observability": { "enabled": true }
}
